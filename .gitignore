# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Tool caches
# (ruff and uv also drop their own .gitignore inside these, but be explicit)
.ruff_cache/
.uv-cache/

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Virtual environments
.venv

# Local env files (may hold real secrets)
.env
.env.local

# macOS
.DS_Store

# Claude Code (local-only settings; the shared .claude/settings.json is committed)
.claude/settings.local.json

# Personal sbx environment overlays (see docs/knowledge/runbooks/agent-sandbox-sbx.md)
.sandbox/local.yaml
